# Copie para .env e ajuste. NUNCA faça commit do .env.

NODE_ENV=development
PORT=3000
# URL pública do site (usada em SEO, sitemap e Open Graph)
PUBLIC_URL=http://localhost:3000

# Segredo para assinar tokens (mínimo 32 caracteres, OBRIGATÓRIO em produção).
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Caminho do banco SQLite (em produção, aponte para o volume persistente)
DB_PATH=database/loja.db
# Pasta das imagens enviadas pelo admin (também deve ficar no volume persistente)
UPLOADS_DIR=uploads

# Dias que o login fica salvo
SESSION_DAYS=30
# Quantos proxies reversos existem antes do app (Railway/Render/Nginx: 1)
TRUST_PROXY=0

# Admin inicial criado pelo "npm run seed" (mín. 10 caracteres, letras e números)
ADMIN_EMAIL=
ADMIN_SENHA=
